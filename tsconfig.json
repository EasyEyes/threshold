{
  "compilerOptions": {
    "outDir": "./js",
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "module": "es2022",
    "target": "es2021",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
  },
  "exclude": ["node_modules", "js", "tests", "notes"]
}
