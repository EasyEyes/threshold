exports[`Part B: per-check trigger scenarios readingQuestionsClickOnly — fires its check, output unchanged 1`] = `
[
  {
    "context": "preprocessor",
    "hint": "Set <span class="alert-parameter">responseClickedBool</span> <code class="alert-value">TRUE</code> for this reading condition, or enable the keypad, or remove the reading questions. The offending column is: C",
    "kind": "error",
    "message": "Reading questions (<span class="alert-parameter">readingNumberOfQuestions</span>) are answered only by clicking the answer words on screen or by the EasyEyes keypad (when <span class="alert-parameter">viewingDistanceDesiredCm</span> exceeds <span class="alert-parameter">needKeypadBeyondCm</span>). Typing cannot answer them, so with <span class="alert-parameter">responseClickedBool</span> <code class="alert-value">FALSE</code> and no keypad in use the participant could never answer and the experiment would wait forever.",
    "name": "Reading questions cannot be answered",
    "parameters": [
      "readingNumberOfQuestions",
      "responseClickedBool",
      "viewingDistanceDesiredCm",
      "needKeypadBeyondCm",
    ],
  },
  {
    "context": "preprocessor",
    "hint": "Set <span class="alert-parameter">targetTask</span> to one of: <code class="alert-value">identify</code>, <code class="alert-value">detect</code>, <code class="alert-value">questionAnswer</code>, <code class="alert-value">questionAndAnswer</code>, <code class="alert-value">adjust</code>. To display a page of text (e.g. reading or a beauty rating), use <span class="alert-parameter">targetTask</span>=<code class="alert-value">identify</code> with <span class="alert-parameter">targetKind</span>=<code class="alert-value">reading</code> and <span class="alert-parameter">thresholdParameter</span>=<code class="alert-value"><span class="alert-parameter">targetDurationSec</span></code>.<br/>Note: <code class="alert-value">questionAnswer</code> is the newer version and will eventually replace <code class="alert-value">questionAndAnswer</code>.<br/>Check column C.",
    "kind": "error",
    "message": "Lacking a <span class="alert-parameter">targetTask</span>, EasyEyes cannot determine the purpose of this <span class="alert-parameter">block</span>. Every <span class="alert-parameter">block</span> needs a <span class="alert-parameter">targetTask</span> so EasyEyes knows what to do: present a task, ask a question, or display text.",
    "name": "No targetTask provided",
    "parameters": [
      "targetTask",
    ],
  },
]
`;

